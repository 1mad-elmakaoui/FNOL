# --- Required for extraction (the only thing that leaves the machine is transcript TEXT) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional: enables pyannote diarization (accept the model terms on huggingface.co first:
#     pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0). Without it, a simple
#     energy-based two-speaker split is used and the worker logs a warning.
HF_TOKEN=

# --- ASR: tiny | base | small | medium | large-v3 (small is a good CPU default) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# Force a language (fr/en/ar) instead of auto-detection:
WHISPER_LANGUAGE=

# --- Embeddings: sentence-transformers (BAAI/bge-m3, ~2.3 GB download on first use) or hashing (no download) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3

# --- Behaviour ---
AUTO_EXTRACT=true
DEFAULT_SCHEMA=fnol
CALL_TIMEZONE=Europe/Paris
REDACTION_ENABLED=true
AGENT_MAX_TOOL_CALLS=40
AGENT_MAX_ITERATIONS=25
LOG_LEVEL=INFO

# --- Infrastructure ---
POSTGRES_USER=fnol
POSTGRES_PASSWORD=fnol
POSTGRES_DB=fnol
API_PORT=8000
WEB_PORT=3000
